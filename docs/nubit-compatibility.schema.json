{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["backend", "frontend", "protocols"],
  "properties": {
    "backend": { "$ref": "#/$defs/packageLine" },
    "frontend": { "$ref": "#/$defs/packageLine" },
    "protocols": {
      "type": "object",
      "required": ["grid"],
      "properties": { "grid": { "type": "string", "format": "uri" } }
    }
  },
  "$defs": {
    "packageLine": {
      "type": "object",
      "required": ["line", "packages"],
      "properties": {
        "line": { "type": "string", "pattern": "^0\\.[0-9]+$" },
        "packages": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}

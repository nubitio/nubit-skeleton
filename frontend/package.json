    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@nubitio/admin": "^1.3.1",
    "@nubitio/core": "^1.3.1",
    "@nubitio/crud": "^1.3.1",
    "@nubitio/dashboard": "^1.3.1",
    "@nubitio/hydra": "^1.3.1",
    "@nubitio/react-admin": "^1.3.1",
    "@nubitio/ui": "^1.3.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tanstack/react-query": "^5.108.2",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "i18next": "^27.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"

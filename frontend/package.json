{
  "name": "nubit-skeleton-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-themes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-themes.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",

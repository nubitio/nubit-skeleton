{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "carthage-software/mago": "^1.40",
        "phpunit/phpunit": "^12.0"
    },
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4.1",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "nelmio/cors-bundle": "^2.6",
        "nubitio/admin-bundle": "^0.15.1",
        "nubitio/tenant-bundle": "^0.15.1",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.0",
        "php-http/guzzle7-adapter": "^1.0",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@test",
            "@stan",
            "@cs",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:container"
        ],
        "stan": "mago analyze --baseline mago-analysis-baseline.toml",
        "lint": "mago lint --baseline mago-lint-baseline.toml",
        "cs": [
            "@lint",
            "mago fmt --dry-run"
        ],
        "cs-fix": "mago lint --fix && mago fmt",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "name": "nubitio/nubit-skeleton",
    "description": "Full-stack starter: Symfony + API Platform + nubitio/admin-bundle + @nubitio/react-admin"
}
